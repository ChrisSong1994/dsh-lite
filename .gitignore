# ==============================================================================
# DSH Lite - Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment and secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12

# ------------------------------------------------------------------------------
# Operating system
# ------------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# Editors and IDEs
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
*.swp
*.swo
*.swn
*~
.project
.classpath
.settings/

# ------------------------------------------------------------------------------
# Logs and temporary files
# ------------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.temp
*.pid
*.seed
*.bak
*.orig
*.rej

# ------------------------------------------------------------------------------
# Python / uv / FastAPI
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.python-version.local
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
*.egg-info/
.eggs/
build/
dist/
sdist/
wheels/
pip-wheel-metadata/
site/
.installed.cfg
*.egg
MANIFEST

# Python bytecode and caches generated by tools
.python_history
.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# Local database and runtime data
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.sqlite3-shm
*.sqlite3-wal
data/
runtime/
.dsh-lite/

# ------------------------------------------------------------------------------
# Node.js / pnpm / React / Vite
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
.npm/
.yarn/
.yarn-cache/
.eslintcache
.stylelintcache
.cache/
.parcel-cache/
.turbo/
.vite/
.vite-inspect/
dist-ssr/
*.tsbuildinfo

# Vite environment overrides
*.local

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Frontend test and coverage artifacts
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
playwright-report/
blob-report/
test-results/
cypress/screenshots/
cypress/videos/
cypress/downloads/

# ------------------------------------------------------------------------------
# Build and deployment artifacts
# ------------------------------------------------------------------------------
.DS_Store?
*.zip
*.tar
*.tar.gz
*.tgz

# ------------------------------------------------------------------------------
# Local tooling state
# ------------------------------------------------------------------------------
.codex-cache/
.cursor/
.aider*
.claude/
